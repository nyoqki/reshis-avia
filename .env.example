# Copy to .env and adjust. Placeholders only, never commit real values.
REHIS_FORECAST_PATH=data/seasonal_forecast.csv
REHIS_ROUTES_PATH=data/routes.csv
REHIS_DB_PATH=var/rehis.sqlite3
# REHIS_STATIC_DIR=frontend/dist
# Uncomment for local http development (cookie without the Secure flag).
# REHIS_COOKIE_SECURE=false
REHIS_SESSION_TTL_HOURS=168
REHIS_ALLOWED_HOSTS=localhost,127.0.0.1
REHIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
REHIS_TRUSTED_PROXIES=127.0.0.1
REHIS_DEMO_USERNAME=demo
REHIS_DEMO_PASSWORD=change-me-demo-password
REHIS_REGISTRATION_OPEN=true
REHIS_MAX_USERS=1000
